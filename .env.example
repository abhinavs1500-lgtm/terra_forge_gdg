# TerraShield AI / Terra Forge Environment Configuration
# Copy this file to .env and adjust variables as needed

# Development server port (defaults to 5173)
VITE_PORT=5173

# Optional: External Map & Tile Service Configurations (Uses open OpenStreetMap / CARTO basemaps by default)
# VITE_MAPBOX_TOKEN=your_token_here

# API Base URL (leave empty for Vite proxy to local backend)
VITE_API_BASE_URL=
